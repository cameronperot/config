SECCOMP_ENOSYS = (
    "clone3",
    "open_tree",
    "move_mount",
    "fsopen",
    "fsconfig",
    "fsmount",
    "fspick",
    "mount_setattr",
)
# Exceeds Flatpak, which denies only CLONE_NEWUSER; CLONE_NEWTIME's bit is clone()'s
# exit-signal field
CLONE_NAMESPACES = (
    os.CLONE_NEWNS,
    os.CLONE_NEWCGROUP,
    os.CLONE_NEWUTS,
    os.CLONE_NEWIPC,
    os.CLONE_NEWUSER,
    os.CLONE_NEWPID,
    os.CLONE_NEWNET,
)
# Compared on the low 32 bits, as the kernel does
IOCTL_DENIED = (termios.TIOCSTI, termios.TIOCLINUX)
PER_LINUX = 0
SOCKET_FAMILIES = (
    socket.AF_UNSPEC,
    socket.AF_UNIX,
