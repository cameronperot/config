[user]
    email = cameronperot@users.noreply.github.com
    name = Cameron Perot
    signingkey = (redacted)
[commit]
    gpgsign = true
[gpg]
    format = ssh
[gpg "ssh"]
    allowedSignersFile = ~/.ssh/allowed_signers
[core]
    editor = nvim
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    dark = true
    minus-style = normal "#75171a"
    minus-emph-style = bold "#ffffff" "#da0023"
    plus-style = syntax "#0b4112"
    plus-emph-style = bold "#ffffff" "#008020"
    line-numbers = true
    line-numbers-minus-style = bold "#f76c66"
    line-numbers-plus-style = bold "#34c448"
[merge]
    conflictStyle = zdiff3
[pull]
    rebase = false
[gc]
    worktreePruneExpire = never
[alias]
    change-commits = "!f() { VAR=$1; OLD=$2; NEW=$3; shift 3; git filter-branch --env-filter \"if [[ \\\"$`echo $VAR`\\\" = '$OLD' ]]; then export $VAR='$NEW'; fi\" $@; }; f"
