        "zwp_linux_dmabuf_v1",
        "wp_linux_drm_syncobj_manager_v1",
        "zwp_primary_selection_device_manager_v1",
    }
)
SECURITY_CONTEXT_MANAGER = "wp_security_context_manager_v1"

# Flatpak 1.18.4's non-devel, no-multiarch filter; every other syscall is allowed
SECCOMP_EPERM = (
    "syslog",
    "uselib",
    "acct",
    "quotactl",
    "add_key",
    "keyctl",
