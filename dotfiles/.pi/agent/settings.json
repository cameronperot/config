{
  "defaultProvider": "opencode-go",
  "defaultModel": "glm-5.3-flash",
  "defaultThinkingLevel": "max",
  "enabledModels": [
    "**/deepseek-v4*",
    "**/kimi-k3",
    "**/glm-5.3@(|-flash)",
    "**/gpt-6*-@(luna|sol|astra)",
    "**/gemini-3.8-flash",
    "**/claude-opus-5.5"
  ],
  "showCacheMissNotices": true,
  "defaultTools": [
    "read",
    "bash",
    "edit",
    "write",
    "grep",
    "find",
    "ls"
  ],
  "packages": [
    "npm:@plannotator/pi-extension",
    "npm:pi-rewind@0.5.0"
  ],
  "enableInstallTelemetry": false,
  "theme": "onedark",
  "editorPaddingX": 0,
  "outputPad": 0,
  "branchSummary": {
    "skipPrompt": true
  },
  "tuiMode": "regular",
  "hideThinkingBlock": false,
  "lastChangelogVersion": "1.0.0"
}
