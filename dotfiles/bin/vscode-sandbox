# User configuration: always-mounted roots (relative paths are under $HOME), forwarded
# localhost ports, extra Electron switches and extra sandbox environment variables
ROOTS: tuple[tuple[str, Literal["ro", "rw"]], ...] = ()
PORTS: tuple[int, ...] = ()
CODE_ARGS = ("--disable-features=WaylandFractionalScaleV1",)
EXTRA_ENV: Mapping[str, str] = MappingProxyType({})

# Absolute paths, never looked up on PATH
BWRAP = "/usr/bin/bwrap"
PASTA = "/usr/bin/pasta"
ELECTRON = "/usr/share/code/code"

# Applied after CODE_ARGS; Chromium keeps the last value of a repeated switch
ELECTRON_SWITCHES = (
    "--no-sandbox",
    "--ozone-platform=wayland",
    "--password-store=basic",
)

READY_TIMEOUT = 30.0
WAYLAND_TIMEOUT = 5.0

# Relative to $XDG_RUNTIME_DIR; never mounted, so no root may overlap it
STATE_DIR = "vscode-sandbox"
# The only entry of the host-only state directory that outlives a launch
LOCK_FILE = "lock"

# Forwarded to the guard as SIGTERM by the supervisor; any of them, or the
# supervisor's death through the guard's PR_SET_PDEATHSIG, makes the guard stop the
# sandbox
STOP_SIGNALS = (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)
PR_SET_PDEATHSIG = 1
PR_SET_CHILD_SUBREAPER = 36

# How often the guard looks for the outer stage until it has found it
OUTER_SCAN_INTERVAL = 0.05

# pasta forwards DNS sent to this address; the host's 127.0.0.53 stub is unreachable
DNS_FORWARD = "169.254.1.1"
RESOLV_CONF = "/etc/resolv.conf"

# The only environment keys the launcher reads, besides LC_*; no variable can bypass
# a protection
ENV_KEYS = frozenset({"HOME", "XDG_RUNTIME_DIR", "WAYLAND_DISPLAY", "LANG"})

# Only render nodes are exposed; primary nodes allow modesetting
DRI_DIR = "/dev/dri"
SYS_PATHS = ("/sys/block", "/sys/bus", "/sys/class", "/sys/dev", "/sys/devices")

# pasta's stdio is /dev/null because SELinux's pasta_t may not write the log; fd 3
# carries the seccomp program to bwrap, fd 4 the ready FIFO's write end. pasta closes
# inherited descriptors, so the outer stage opens all of them after it
OUTER_STAGE = 'exec >>"$1" 2>&1 3<"$2" 4>"$3"; shift 3; exec "$@"'
# Runs after bwrap's setup, seccomp included, and keeps fd 4 from the command
INNER_STAGE = 'printf r >&4 && exec 4>&- && exec "$@"'
# Bound over the ~/bin/code shim inside the sandbox, so `code` in the integrated
# terminal reaches the running window instead of starting a nested launch. The RPM's
# CLI finds its install through $0, so /usr/bin/code itself cannot be bound there. The
# CLI passes its arguments to a second Electron that hands off to the window; it gets
# the wrapper-owned switches, as without --no-sandbox Chromium aborts on its setuid
# sandbox first. CODE_ARGS is left out: the CLI warns on every call about switches it
# does not know, and the handoff opens no window
SANDBOX_CODE = f'#!/bin/sh\nexec /usr/bin/code {shlex.join(ELECTRON_SWITCHES)} "$@"\n'

HOME_RO_PATHS = (
    ".micromamba",
    "bin",
    ".local/bin",
    ".config/nvim",
    ".local/share/uv/python",
    ".gitconfig",
    ".local/share/jupyter/kernels",
    ".local/share/fonts",
    ".fonts",
    ".config/fontconfig",
    ".icons",
    ".local/share/icons",
    ".themes",
    ".config/gtk-3.0",
    ".config/gtk-4.0",
)
HOME_RW_PATHS = (".config/Code", ".vscode", ".vscode-shared")

# Relative to $HOME; the private store is never visible as a whole inside the sandbox
STORE = ".local/share/vscode-sandbox"

SYSTEM_TREES = (
    "/usr",
    "/bin",
    "/sbin",
    "/lib",
    "/lib64",
    "/etc",
    "/opt",
    "/var",
    "/boot",
    "/root",
    "/srv",
    "/tmp",
    "/run",
    "/proc",
    "/sys",
    "/dev",
)

# A read-only constant root may not be or cover these, $HOME or a protected path
RO_ROOT_LIMITS = ("/", "/run", "/data")

# A read-only root may not lie inside these: a read-only bind still exposes sockets
RO_ROOT_EXCLUDED_TREES = ("/run", "/tmp", "/dev", "/proc", "/sys")

# Globals Sway 1.11 advertises to security-context clients, conditional ones included;
# any other advertised global aborts the launch
WAYLAND_GLOBALS = frozenset(
