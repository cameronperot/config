{
  "zeroAccessAllowPaths": [".env.example", ".env-example", ".env.template", ".env.sample"],

  "zeroAccessPaths": [
    "*.env",
    "*.p12",
    "*.key",
    "*key.pem",
    "*.priv",
    ".env",
    ".env.*",
    ".git-credentials",
    "auth.json",
    "auth.toml",
    "auth.yaml",
    "auth.yml",
    "credentials.json",
    "credentials.toml",
    "credentials.yaml",
    "credentials.yml",
    "secrets.json",
    "secrets.toml",
    "secrets.yaml",
    "secrets.yml",
    "~/*secret*",
    "~/.aws/",
    "~/.git-credentials",
    "~/.gnupg/",
    "~/.netrc",
    "~/.ssh/"
  ],

  "readOnlyPaths": [
  ],

  "noDeletePaths": [
  ],

  "bashPatterns": [
    { "pattern": "\\brm\\s+(-[^\\s]*)*-[rRf]", "reason": "rm with recursive or force flags", "ask": true, "sandboxExemption": "tmp-cleanup" },
    { "pattern": "\\brm\\s+--(recursive|force)\\b", "reason": "rm with --recursive or --force", "ask": true, "sandboxExemption": "tmp-cleanup" },
    { "pattern": "\\bsudo\\b", "reason": "sudo (runs as root)", "ask": true, "sandboxExemption": "host" },
    { "pattern": "\\b(chmod|chown)\\b[^|;]*\\b777\\b", "reason": "chmod/chown involving 777 (permissions or ownership)", "ask": true, "sandboxExemption": "tmp-permissions" },

    { "pattern": "\\bgit\\s+reset\\b[^|;&\\n]*\\s--hard\\b", "reason": "git reset --hard discards uncommitted work (use --soft or stash)", "ask": true },
    { "pattern": "\\bgit\\s+clean\\s+(-[^\\s]*)*-[fd]", "reason": "git clean -f/-d deletes untracked files", "ask": true, "commandExemption": "git-dry-run" },
    { "pattern": "\\bgit\\s+checkout\\b[^|;&\\n]*\\s--\\s", "reason": "git checkout -- restores paths and discards uncommitted changes", "ask": true },
    { "pattern": "\\bgit\\s+restore\\b", "reason": "git restore can discard uncommitted changes", "ask": true, "commandExemption": "git-index" },
    { "pattern": "\\bgit\\s+branch\\s+(-[^\\s]*)*-D\\b", "reason": "git branch -D force-deletes an unmerged branch", "ask": true },
    { "pattern": "\\bgit\\s+push\\s+[^|;]*--force(?!-with-lease)", "reason": "git push --force overwrites remote history (use --force-with-lease)" },
    { "pattern": "\\bgit\\s+push\\b[^|;]*\\s-{1,2}[a-zA-Z]*f\\b", "reason": "git push -f overwrites remote history (use --force-with-lease)" },
    { "pattern": "\\bgit\\s+stash\\s+clear\\b", "reason": "git stash clear deletes every stash" },
    { "pattern": "\\bgit\\s+reflog\\s+expire\\b", "reason": "git reflog expire destroys the recovery mechanism" },
    { "pattern": "\\bgit\\s+filter-branch\\b", "reason": "git filter-branch rewrites entire history" },
    { "pattern": "\\bgit\\s+worktree\\s+(prune|remove)\\b", "reason": "git worktree prune/remove drops worktree entries; unmounted siblings look deleted from inside a container or sandbox", "ask": true, "commandExemption": "git-dry-run" },

    { "pattern": "\\bDROP\\s+DATABASE\\b", "reason": "DROP DATABASE" },
    { "pattern": "\\bDROP\\s+(TABLE|SCHEMA)\\b", "reason": "DROP TABLE/SCHEMA", "ask": true },
    { "pattern": "\\bTRUNCATE\\s+TABLE\\b", "reason": "TRUNCATE TABLE deletes all rows", "ask": true },
    { "pattern": "\\bDELETE\\s+FROM\\s+\\w+\\s*(;|$)", "reason": "DELETE FROM with no WHERE clause deletes all rows", "ask": true },

    { "pattern": "\\b(curl|wget)\\b[^|;]*\\|\\s*(ba|z)?sh\\b", "reason": "piping a download straight into a shell (remote code execution)", "ask": true },
    { "pattern": "\\bmkfs\\.", "reason": "filesystem format command", "sandboxExemption": "host" },
    { "pattern": "\\bdd\\b[^|;]*\\bof=/dev/", "reason": "dd writing to a raw device", "sandboxExemption": "host" }
  ]
}
