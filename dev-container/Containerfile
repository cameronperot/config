FROM debian:13

# Args
ARG TZ=UTC
ARG NEW_USER=user
ARG NEW_UID=1000
ARG NEW_GID=1000
ARG HOME_DIR=/home/${NEW_USER}
ARG GIT_SIGNING_KEY=""
ARG MP_SKILLS_REPO_REF=4ae2317ddb22b046e26455e4f9c9b3aaaf62212d
ARG HERDR_VERSION=v0.9.5
ARG OPENCODE_VERSION=1.19.5
ARG PI_VERSION=1.5.0
ARG OMP_VERSION=18.18.0
ARG DEBIAN_FRONTEND=noninteractive

# Env vars
ENV COLORTERM=truecolor \
    container=oci \
    EDITOR=nvim \
    LANG=en_US.UTF-8 \
    CLAUDE_CONFIG_DIR="${HOME_DIR}/.claude" \
    LC_ALL=en_US.UTF-8 \
    MAMBA_ROOT_PREFIX=/opt/mamba \
    SHELL=/usr/bin/zsh \
    TERM=xterm-kitty \
    TZ="${TZ}" \
    VISUAL=nvim
ENV PATH="${HOME_DIR}/bin:${HOME_DIR}/.local/bin:${HOME_DIR}/.bun/bin:${MAMBA_ROOT_PREFIX}/envs/dev/bin:${MAMBA_ROOT_PREFIX}/bin:${PATH}"

# Debian packages
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
    aggregate \
    bat \
    btop \
    bubblewrap \
    build-essential \
    bzip2 \
    ca-certificates \
    cmake \
    curl \
    dnsutils \
    fd-find \
    fontconfig \
    fzf \
    gdb \
    git \
    git-delta \
    gnupg2 \
    iproute2 \
    ipset \
    iputils-ping \
    jq \
    kitty-terminfo \
    less \
    libclang-dev \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    locales \
    lsd \
    man-db \
    neovim \
    net-tools \
    netbase \
    netcat-openbsd \
    openssh-client \
    pandoc \
    pkg-config \
    procps \
    ripgrep \
    rsync \
    sd \
    shellcheck \
    shfmt \
    socat \
    sudo \
    tar \
    tmux \
    traceroute \
    tree \
    unzip \
    wget \
    yq \
    zip \
    zsh \
    && apt-get clean all \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/fdfind /usr/bin/fd

# Install gh from the official GitHub CLI repository
RUN mkdir -p -m 755 /etc/apt/keyrings /etc/apt/sources.list.d \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && apt-get clean all \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

RUN sed -i -e 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen \
    && locale-gen

# Create dev user with sudo access
RUN groupadd -g "${NEW_GID}" "${NEW_USER}" \
    && useradd -l -m -u "${NEW_UID}" -g "${NEW_GID}" -d "${HOME_DIR}" -s /usr/bin/zsh "${NEW_USER}" \
    && echo "${NEW_USER}:${NEW_USER}" | chpasswd \
    && usermod -aG sudo "${NEW_USER}"

# Make required directories
RUN mkdir -p \
    "${MAMBA_ROOT_PREFIX}" \
    /work \
    "${HOME_DIR}/.local/state" \
    "${HOME_DIR}/.ssh" \
    && chmod 700 "${HOME_DIR}/.ssh" \
    && chown -R "${NEW_USER}:${NEW_USER}" "${MAMBA_ROOT_PREFIX}" /work "${HOME_DIR}"

USER "${NEW_USER}"

# Install uv and micromamba
RUN curl -LsSf https://astral.sh/uv/install.sh | UV_NO_MODIFY_PATH=1 sh && uv python install 3.14
RUN curl -fsSL https://raw.githubusercontent.com/cameronperot/shell-scripts/refs/heads/master/scripts/install_micromamba.sh | bash
COPY --chown="${NEW_USER}:${NEW_USER}" environment.yml /tmp/environment-setup/environment.yml
RUN micromamba env create -f /tmp/environment-setup/environment.yml \
    && micromamba clean --all --yes

# Install bun
RUN curl -fsSL https://bun.com/install | bash

# Install coding agents with bun at pinned versions
RUN BUN_INSTALL_BIN="${HOME_DIR}/.local/bin" bun install -g \
    "opencode-ai@${OPENCODE_VERSION}" \
    "@earendil-works/pi-coding-agent@${PI_VERSION}" \
    "@oh-my-pi/pi-coding-agent@${OMP_VERSION}"

# Install Herdr from a pinned GitHub release
RUN case "$(dpkg --print-architecture)" in \
        amd64) herdr_arch=x86_64 ;; \
        arm64) herdr_arch=aarch64 ;; \
        *) echo "unsupported architecture for Herdr" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://github.com/herdrdev/herdr/releases/download/${HERDR_VERSION}/herdr-linux-${herdr_arch}" \
        -o "${HOME_DIR}/.local/bin/herdr" \
    && chmod 755 "${HOME_DIR}/.local/bin/herdr" \
    && "${HOME_DIR}/.local/bin/herdr" --version

COPY --chown="${NEW_USER}:${NEW_USER}" . /tmp/environment-setup/

# Configure dev environment
RUN test -n "${GIT_SIGNING_KEY}" || { echo "GIT_SIGNING_KEY build arg is required" >&2; exit 1; } \
    && "${MAMBA_ROOT_PREFIX}/envs/dev/bin/python" /tmp/environment-setup/install.py --neovim-version none \
    && rm -rf "${HOME_DIR}/.config/nvim" \
    && mkdir -p "${HOME_DIR}/.jupyter" \
    && cp /tmp/environment-setup/dev-container/jupyter_server_config.py "${HOME_DIR}/.jupyter/jupyter_server_config.py" \
    && git config --global user.signingkey "${GIT_SIGNING_KEY}" \
    && echo "$(git config user.email) $(git config user.signingkey)" >> "${HOME_DIR}/.ssh/allowed_signers"

# Install shared skills from mattpocock/skills at a pinned commit
RUN git clone --quiet https://github.com/mattpocock/skills.git /tmp/mattpocock-skills \
    && git -C /tmp/mattpocock-skills checkout --quiet "${MP_SKILLS_REPO_REF}" \
    && mkdir -p "${HOME_DIR}/.agent/skills" \
    && cp -r \
        /tmp/mattpocock-skills/skills/productivity/grill-me \
        /tmp/mattpocock-skills/skills/productivity/grilling \
        "${HOME_DIR}/.agent/skills/" \
    && rm -rf /tmp/mattpocock-skills

# Configure agents
RUN rm -rf "${HOME_DIR}/.pi/agent/prompts" "${HOME_DIR}/.pi/agent/skills" "${HOME_DIR}/.omp/agent/prompts" "${HOME_DIR}/.omp/agent/skills" \
    && ln -s "${HOME_DIR}/.agent/skills" "${HOME_DIR}/.pi/agent/skills" \
    && ln -s "${HOME_DIR}/.agent/skills" "${HOME_DIR}/.omp/agent/skills" \
    && ln -s "${HOME_DIR}/.agent/prompts" "${HOME_DIR}/.pi/agent/prompts" \
    && ln -s "${HOME_DIR}/.agent/prompts" "${HOME_DIR}/.omp/agent/prompts"

# Shadow the agent names on PATH in ~/bin
RUN for agent in pi omp opencode; do ln -s agent-shadow "${HOME_DIR}/bin/${agent}"; done

# Initialize antidote and zsh plugins
RUN zsh -ic exit

# Configure root environment
USER root
RUN chown -R root:root /tmp/environment-setup \
    && "${MAMBA_ROOT_PREFIX}/envs/dev/bin/python" /tmp/environment-setup/install.py --neovim-version v0.12.6 --extract-appimage \
    && rm -rf "/root/.config/nvim" \
    && rm -rf /tmp/environment-setup \
    && echo "source /root/.bash_aliases" >> /root/.bashrc
USER "${NEW_USER}"

# Custom entry point to drop from guest root to the OCI user under krun
COPY --chmod=0755 dev-container/entrypoint.sh /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bash"]

# Set the working directory
WORKDIR /work
