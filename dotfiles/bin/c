#!/usr/bin/env python3
"""c — run a command in a dev:latest container.

By default a throwaway container is created with `podman run --rm`: the
repository root is bind-mounted at its host path so git's absolute worktree
links stay valid inside, the container starts in the current directory, and it
gets the agent dotfiles from $AGENT_CONFIG_DIR plus the host's isolated
ssh-agent (a socket bind mount, or under -k a pasta TCP bridge that the image
entrypoint connects to SSH_AUTH_SOCK). If the signing socket does not exist,
`c` warns and starts the container without it; ssh signing then fails at
commit time. Under -k, before booting, `c` probes the host's bridge port with
an ssh-agent identity request and warns when no signer answers. With
--no-git-signing (or a non-empty GIT_SIGNING_DISABLED), both checks are
skipped, no agent socket is mounted or bridged, and commit.gpgsign=false is injected via
GIT_CONFIG_* so commits succeed unsigned; GIT_SIGNING_DISABLED=1 is passed
into the container so agent-sandbox does not warn about the unset socket.

With -r (or -c) the command runs instead in the already-running container whose
bind mount contains the current directory, translated to its container path.

Mounted at its host path: the directory holding `.bare` for a `.bare` layout
(plus the toplevel when it lies elsewhere), the toplevel and the common git dir
for a linked worktree of a plain repository, otherwise the toplevel, or the
current directory outside git. With --no-git-root only the current directory
is mounted and git metadata stays outside.

The Plannotator plan UI port is exposed by default: a free loopback port is
picked on the host and published one-to-one into the container, with
PLANNOTATOR_REMOTE=1 and PLANNOTATOR_PORT set so the URL Plannotator prints
inside is already clickable on the host. `--plannotator-port PORT` pins the
port, `--no-plannotator-port` opts out.
"""

import argparse
import json
import os
import shlex
import socket
import struct
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path

ENGINE = "podman"
IMAGE = "dev:latest"
PREFERRED_CONTAINER = "dev_container"
CONTAINER_HOME = Path("/home/user")
# /run rejects the socket bind in the krun guest, hence /tmp
CONTAINER_SSH_SOCK = "/tmp/ssh-agent.sock"
KRUN_SSH_PORT = 7777
# host loopback address the krun TCP signer check probes
SSH_PROBE_HOST = "127.0.0.1"
KRUN_CPUS = 4
KRUN_RAM_MIB = 8192
# (path under AGENT_CONFIG_DIR, path under CONTAINER_HOME), parents before children.
# The host's .pi/agent and .omp/agent shadow the image's symlinks to
# .agent/{skills,prompts}, so those two are mounted again underneath each agent.
AGENT_CONFIG_MOUNTS = (
    (".agent", ".agent"),
    (".pi/agent", ".pi/agent"),
    (".omp/agent", ".omp/agent"),
    (".agent/skills", ".pi/agent/skills"),
    (".agent/skills", ".omp/agent/skills"),
    (".agent/prompts", ".pi/agent/prompts"),
    (".agent/prompts", ".omp/agent/prompts"),
    (".plannotator", ".plannotator"),
)


class Error(Exception):
    """Fatal condition reported as `c: error: ...`."""


@dataclass(frozen=True)
class Mount:
    """A bind mount of a running container."""

    source: Path
    destination: Path

    def contains(self, path: Path) -> bool:
        """Report whether ``path`` lies at or under the mount source.

        Args:
            path: Absolute host path.

        Returns:
            True when ``path`` is the source or inside it.
        """
        return path.is_relative_to(self.source)

    def translate(self, path: Path) -> Path:
        """Map a host path under the source to its path inside the container.

        Args:
            path: Absolute host path at or under the source.

        Returns:
            The corresponding path under the destination.
        """
        return self.destination / path.relative_to(self.source)


@dataclass(frozen=True)
class Container:
    """A running container and its bind mounts."""

    id: str
    name: str
    mounts: tuple[Mount, ...]


def run(*argv: str) -> str:
    """Run an engine command and return its stdout.

    Args:
        *argv: The command and its arguments.

    Returns:
        The command's stdout.

    Raises:
        Error: When the executable is missing or exits non-zero; the message
            carries the command's stderr.
    """
    try:
        result = subprocess.run(argv, capture_output=True, text=True, check=True)
    except FileNotFoundError:
        raise Error(f"{argv[0]}: command not found") from None
    except subprocess.CalledProcessError as e:
        raise Error(f"{argv[0]} failed: {e.stderr.strip()}") from None
    return result.stdout


def git_rev_parse(cwd: Path, *args: str) -> Path:
    """Run ``git rev-parse`` in ``cwd`` and resolve the printed path.

    Args:
        cwd: Directory to run git in.
        *args: ``rev-parse`` arguments.

    Returns:
        The printed path, with symlinks resolved.

    Raises:
        subprocess.CalledProcessError: When git exits non-zero, e.g. outside a
            work tree.
    """
    result = subprocess.run(
        ["git", "-C", str(cwd), "rev-parse", *args],
        capture_output=True,
        text=True,
        check=True,
    )
    return Path(result.stdout.strip()).resolve()


def resolve_mounts(cwd: Path) -> tuple[Path, ...]:
    """Directories to bind at their host paths so git works inside the container.

    Args:
        cwd: The resolved current directory.

    Returns:
        Outside a work tree (a non-git dir, or the ``.bare`` parent itself) just
            ``cwd``. In a ``.bare`` layout the directory containing ``.bare``, plus
            the toplevel when it lies elsewhere. In a linked worktree of a plain
            repo the toplevel and the common git dir. Otherwise the toplevel.
    """
    try:
        toplevel = git_rev_parse(cwd, "--show-toplevel")
    except subprocess.CalledProcessError:
        return (cwd,)
    common = git_rev_parse(cwd, "--path-format=absolute", "--git-common-dir")
    if common.is_relative_to(toplevel):
        return (toplevel,)
    if common.name == ".bare":
        parent = common.parent
        if toplevel.is_relative_to(parent):
            return (parent,)
        return (parent, toplevel)
    return (toplevel, common)


def pick_free_port() -> int:
    """Grab a free loopback port from the host.

    Binds an ephemeral port and closes the socket again, so the port is
    free at call time; the engine later fails loudly if something takes it
    in between.

    Returns:
        The port number.

    Raises:
        Error: When no port can be bound.
    """
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        sock.bind(("127.0.0.1", 0))
    except OSError as e:
        raise Error(f"cannot pick a free plannotator port: {e}") from None
    port = sock.getsockname()[1]
    sock.close()
    return port


def probe_tcp_signer(host: str, port: int, timeout: float = 1.0) -> bool:
    """Report whether an ssh-agent answers on a TCP endpoint with at least one key.

    Speaks the ssh-agent wire protocol (4-byte big-endian length, then a
    1-byte type) so a dead agent behind a live TCP bridge or an agent with an
    empty key list count as unavailable.

    Args:
        host: Host to probe.
        port: TCP port to probe.
        timeout: Seconds allowed for the connect, the send, and each read.

    Returns:
        True only when the endpoint answers ``SSH_AGENTC_REQUEST_IDENTITIES``
            (type 12) reporting at least one key; connection errors, timeouts,
            malformed replies, and empty key lists return False.
    """
    try:
        with socket.create_connection((host, port), timeout=timeout) as sock:
            # SSH_AGENTC_REQUEST_IDENTITIES: length 1, type 11
            sock.sendall(b"\x00\x00\x00\x01\x0b")
            reply = b""
            while len(reply) < 4:
                chunk = sock.recv(4 - len(reply))
                if not chunk:
                    return False
                reply += chunk
            (length,) = struct.unpack(">I", reply)
            payload = b""
            while len(payload) < length:
                chunk = sock.recv(length - len(payload))
                if not chunk:
                    return False
                payload += chunk
            # SSH_AGENTC_REQUEST_IDENTITIES_ANSWER (12): type byte + key count
            if len(payload) < 5 or payload[0] != 0x0C:
                return False
            (keys,) = struct.unpack(">I", payload[1:5])
            return keys >= 1
    except OSError:
        return False


def check_mount_allowed(path: Path) -> None:
    """Refuse mounting ``$HOME`` or one of its ancestors (``/`` included).

    Bound at an identical path such a mount would shadow the container's home
    and expose the host's.

    Args:
        path: Candidate mount source.

    Raises:
        Error: When ``path`` is ``$HOME`` or an ancestor of it.
    """
    if Path.home().resolve().is_relative_to(path):
        raise Error(f"refusing to mount {path}: it is $HOME or an ancestor of it")


def running_containers() -> tuple[Container, ...]:
    """Inspect every running container.

    Returns:
        One entry per running container with its bind mounts only; a container
            without bind mounts has an empty ``mounts`` tuple.

    Raises:
        Error: When the engine is missing or ``ps``/``inspect`` fail.
    """
    ids = run(ENGINE, "ps", "-q").split()
    if not ids:
        return ()
    containers = []
    for info in json.loads(run(ENGINE, "inspect", *ids)):
        mounts = tuple(
            Mount(source=Path(m["Source"]), destination=Path(m["Destination"]))
            for m in info["Mounts"]
            if m["Type"] == "bind"
        )
        containers.append(Container(id=info["Id"], name=info["Name"], mounts=mounts))
    return tuple(containers)


def select_container(
    *, cwd: Path, containers: tuple[Container, ...], name: str | None
) -> tuple[Container, Mount]:
    """Pick the container and bind mount to exec in for ``cwd``.

    Args:
        cwd: The resolved current directory.
        containers: The running containers.
        name: Restrict the choice to the container with this name or id prefix.

    Returns:
        The ``(container, mount)`` pair whose mount contains ``cwd``, preferring
            ``PREFERRED_CONTAINER``, then the deepest mount, then the first found.

    Raises:
        Error: When no container is running, ``name`` matches none, or no bind
            mount contains ``cwd``.
    """
    if not containers:
        raise Error("no running containers")
    if name is not None:
        containers = tuple(
            c for c in containers if c.name == name or c.id.startswith(name)
        )
        if not containers:
            raise Error(f"no running container named '{name}'")
    candidates = [(c, m) for c in containers for m in c.mounts if m.contains(cwd)]
    if not candidates:
        where = f"'{name}'" if name is not None else "any running container"
        raise Error(f"no bind mount in {where} contains {cwd}")
    return max(
        candidates,
        key=lambda cm: (cm[0].name == PREFERRED_CONTAINER, len(cm[1].source.parts)),
    )


def run_argv(
    *,
    cwd: Path,
    mounts: tuple[Path, ...],
    agent_config_dir: Path,
    ssh_sock: Path | None,
    krun: bool,
    cpus: int | None,
    ram_mib: int | None,
    plannotator_port: int | None,
    signing_disabled: bool,
    extra_args: list[str],
    tty: bool,
    command: list[str],
) -> list[str]:
    """Assemble the ``podman run`` argv for a throwaway dev container.

    Args:
        cwd: Working directory inside the container, identical to the host path.
        mounts: Host directories to bind at their own paths.
        agent_config_dir: Host directory holding the agent dotfiles.
        ssh_sock: Host ssh-agent socket, bind-mounted unless ``krun``; None
            mounts no socket and sets no ``SSH_AUTH_SOCK``.
        krun: Boot a libkrun microVM and bridge the ssh-agent over TCP instead.
        cpus: Under ``krun`` the vCPU count (must be set); otherwise the
            ``--cpus`` limit, omitted when None.
        ram_mib: Under ``krun`` the VM RAM in MiB (must be set); otherwise the
            ``--memory`` limit, omitted when None.
        plannotator_port: Host port for the Plannotator plan UI, published to
            the same port in the container with ``PLANNOTATOR_REMOTE=1`` and
            ``PLANNOTATOR_PORT`` set; omitted when None.
        signing_disabled: When true, omit agent access and inject
            ``commit.gpgsign=false`` via ``GIT_CONFIG_*`` for unsigned commits, and set
            ``GIT_SIGNING_DISABLED=1`` in the container so ``agent-sandbox``
            does not warn about the unset ssh-agent socket.
        extra_args: Additional ``podman run`` arguments, placed before the image.
        tty: Whether to attach an interactive terminal (``-i -t``).
        command: Command to run; empty for the image's default.

    Returns:
        The argv, starting with the engine.
    """
    argv = [
        ENGINE,
        "run",
        "--rm",
        "--userns",
        "keep-id",
        "--security-opt",
        "label=disable",
    ]
    argv += ["-w", str(cwd)]
    for mount in mounts:
        argv += ["-v", f"{mount}:{mount}"]
    for host_rel, container_rel in AGENT_CONFIG_MOUNTS:
        argv += [
            "-v",
            f"{agent_config_dir / host_rel}:{CONTAINER_HOME / container_rel}",
        ]
    if not signing_disabled and (krun or ssh_sock is not None):
        argv += ["-e", f"SSH_AUTH_SOCK={CONTAINER_SSH_SOCK}"]
    if krun:
        # virtio-fs passes files but not Unix-socket endpoints, so instead of
        # mounting the ssh-agent socket, forward guest connections to KRUN_SSH_PORT
        # to the host's loopback signer; the entrypoint bridges SSH_AUTH_SOCK to it
        argv += [
            "--runtime=krun",
            "--network",
            "pasta" if signing_disabled else f"pasta:-T,{KRUN_SSH_PORT}",
            "--annotation",
            f"krun.cpus={cpus}",
            "--annotation",
            f"krun.ram_mib={ram_mib}",
        ]
    else:
        if not signing_disabled and ssh_sock is not None:
            argv += ["-v", f"{ssh_sock}:{CONTAINER_SSH_SOCK}"]
        if cpus is not None:
            argv += ["--cpus", str(cpus)]
        if ram_mib is not None:
            argv += ["--memory", f"{ram_mib}m"]
    if signing_disabled:
        argv += [
            "-e",
            "GIT_CONFIG_COUNT=1",
            "-e",
            "GIT_CONFIG_KEY_0=commit.gpgsign",
            "-e",
            "GIT_CONFIG_VALUE_0=false",
            "-e",
            "GIT_SIGNING_DISABLED=1",
        ]
    if plannotator_port is not None:
        argv += [
            "-p",
            f"127.0.0.1:{plannotator_port}:{plannotator_port}",
            "-e",
            "PLANNOTATOR_REMOTE=1",
            "-e",
            f"PLANNOTATOR_PORT={plannotator_port}",
        ]
    argv += extra_args
    if tty:
        argv += ["-i", "-t"]
    return [*argv, IMAGE, *command]


def exec_argv(*, name: str, workdir: Path, tty: bool, command: list[str]) -> list[str]:
    """Assemble the ``podman exec`` argv for a running container.

    Args:
        name: Container name.
        workdir: Working directory inside the container.
        tty: Whether to attach an interactive terminal (``-i -t``).
        command: Command to run.

    Returns:
        The argv, starting with the engine.
    """
    argv = [ENGINE, "exec", "-w", str(workdir)]
    if tty:
        argv += ["-i", "-t"]
    return [*argv, name, *command]


def build_parser() -> argparse.ArgumentParser:
    """Build the argument parser.

    Returns:
        The parser; ``command`` is an ``argparse.REMAINDER`` positional so the
            command's own flags pass through untouched.
    """
    parser = argparse.ArgumentParser(
        prog="c",
        usage=(
            "%(prog)s [--dry-run] [-k] [--cpus N] [--ram-mib MIB] "
            "[--plannotator-port PORT | --no-plannotator-port] [--no-git-signing] "
            "[--no-git-root] "
            "[-a=ARG ...] [--] [CMD ...]\n"
            "       %(prog)s [--dry-run] -r [-c NAME] [--] CMD ..."
        ),
        description=(
            f"Run CMD in a {IMAGE} container: a throwaway one by default, or with -r "
            "the running one whose bind mount contains the current directory."
        ),
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="print the podman argv instead of running it",
    )
    new = parser.add_argument_group("new container (default)")
    new.add_argument(
        "-k",
        "--krun",
        action="store_true",
        help="boot the container in a libkrun microVM",
    )
    new.add_argument(
        "--cpus",
        type=int,
        metavar="N",
        help=(
            "CPU limit: `podman run --cpus N`, or vCPUs under -k "
            f"(unset: no limit; -k default {KRUN_CPUS})"
        ),
    )
    new.add_argument(
        "--ram-mib",
        type=int,
        metavar="MIB",
        help=(
            "memory limit in MiB: `podman run --memory MIBm`, or RAM under -k "
            f"(unset: no limit; -k default {KRUN_RAM_MIB})"
        ),
    )
    new.add_argument(
        "--plannotator-port",
        type=int,
        metavar="PORT",
        help=(
            "host port for the Plannotator plan UI, published to the same port "
            "in the container (default: a free port is picked)"
        ),
    )
    new.add_argument(
        "--no-plannotator-port",
        action="store_true",
        help="do not expose the Plannotator plan UI port",
    )
    new.add_argument(
        "--no-git-signing",
        "--ngs",
        action="store_true",
        help=(
            "run without commit signing: no signing socket and commit signing "
            "disabled in the container (env: GIT_SIGNING_DISABLED)"
        ),
    )
    new.add_argument(
        "--no-git-root",
        "--ngr",
        action="store_true",
        help=(
            "mount only the current directory instead of walking up to the git "
            "root (git metadata stays unmounted)"
        ),
    )
    new.add_argument(
        "-a",
        "--arg",
        action="append",
        default=[],
        metavar="ARG",
        help=(
            "extra `podman run` argument, repeatable; "
            "write option-like values as -a=--network=host"
        ),
    )
    running = parser.add_argument_group("running container")
    running.add_argument(
        "-r",
        "--running",
        action="store_true",
        help=(
            "exec in the running container whose bind mount contains the current "
            f"directory ({PREFERRED_CONTAINER} preferred)"
        ),
    )
    running.add_argument(
        "-c",
        "--container",
        metavar="NAME",
        help="pick the container by name or id prefix (implies -r)",
    )
    parser.add_argument(
        "command",
        nargs=argparse.REMAINDER,
        metavar="CMD",
        help="command and arguments to run (a new container defaults to the image's)",
    )
    return parser


def usage_errors(args: argparse.Namespace) -> tuple[str, ...]:
    """Check flag combinations the parser cannot express.

    Args:
        args: Parsed arguments, with ``running`` already implied by ``container``.

    Returns:
        One message per problem, for ``parser.error``; empty when valid.
    """
    problems = []
    if args.plannotator_port is not None and args.no_plannotator_port:
        problems.append(
            "--plannotator-port and --no-plannotator-port are mutually exclusive"
        )
    if not args.running:
        return tuple(problems)
    new_only = (
        ("-k/--krun", args.krun),
        ("-a/--arg", bool(args.arg)),
        ("--cpus", args.cpus is not None),
        ("--ram-mib", args.ram_mib is not None),
        ("--plannotator-port", args.plannotator_port is not None),
        ("--no-plannotator-port", args.no_plannotator_port),
        ("--no-git-signing/--ngs", args.no_git_signing),
        ("--no-git-root/--ngr", args.no_git_root),
    )
    given = [flag for flag, on in new_only if on]
    if given:
        problems.append(f"{', '.join(given)} cannot be used with -r/--running")
    if not args.command:
        problems.append("no command specified")
    return tuple(problems)


def new_container(
    args: argparse.Namespace, *, cwd: Path, tty: bool
) -> tuple[list[str], str]:
    """Build the ``podman run`` argv and banner for a throwaway container.

    Args:
        args: Parsed arguments.
        cwd: The resolved current directory.
        tty: Whether stdin is a terminal.

    Returns:
        The argv and the banner printed before exec. Without an existing
            signing socket, and not under ``krun``, a warning is printed to
            stderr and no ssh-agent socket is mounted.

    Raises:
        Error: When a mount is refused, ``AGENT_CONFIG_DIR`` is unset, or no
            free plannotator port can be found.
    """
    mounts = (cwd,) if args.no_git_root else resolve_mounts(cwd)
    for mount in mounts:
        check_mount_allowed(mount)
    agent_config_dir = os.environ.get("AGENT_CONFIG_DIR")
    if not agent_config_dir:
        raise Error("AGENT_CONFIG_DIR must be set to create a new container")
    xdg_runtime_dir = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    signing_disabled = args.no_git_signing or bool(
        os.environ.get("GIT_SIGNING_DISABLED")
    )
    ssh_sock = Path(xdg_runtime_dir) / "llm-agent.sock"
    if args.krun:
        if not signing_disabled and not probe_tcp_signer(SSH_PROBE_HOST, KRUN_SSH_PORT):
            print(
                f"c: warning: {SSH_PROBE_HOST}:{KRUN_SSH_PORT}: "
                "no ssh-agent reachable; running without ssh-agent",
                file=sys.stderr,
            )
    elif signing_disabled:
        ssh_sock = None
    elif not ssh_sock.is_socket():
        print(
            f"c: warning: {ssh_sock}: signing agent socket not found; "
            "running without ssh-agent",
            file=sys.stderr,
        )
        ssh_sock = None
    cpus, ram_mib = args.cpus, args.ram_mib
    if args.krun:
        cpus = KRUN_CPUS if cpus is None else cpus
        ram_mib = KRUN_RAM_MIB if ram_mib is None else ram_mib
    if args.no_plannotator_port:
        plannotator_port = None
    elif args.plannotator_port is not None:
        plannotator_port = args.plannotator_port
    else:
        plannotator_port = pick_free_port()
    cmd = run_argv(
        cwd=cwd,
        mounts=mounts,
        agent_config_dir=Path(agent_config_dir),
        ssh_sock=ssh_sock,
        krun=args.krun,
        cpus=cpus,
        ram_mib=ram_mib,
        plannotator_port=plannotator_port,
        signing_disabled=signing_disabled,
        extra_args=args.arg,
        tty=tty,
        command=args.command,
    )
    mounted = ", ".join(str(m) for m in mounts)
    banner = f"{IMAGE}:{cwd} (mounted: {mounted})"

    return cmd, banner


def exec_running(
    args: argparse.Namespace, *, cwd: Path, tty: bool
) -> tuple[list[str], str]:
    """Build the ``podman exec`` argv and banner for the container matching ``cwd``.

    Args:
        args: Parsed arguments.
        cwd: The resolved current directory.
        tty: Whether stdin is a terminal.

    Returns:
        The argv and the banner printed before exec.

    Raises:
        Error: When the engine fails or no running container matches.
    """
    container, mount = select_container(
        cwd=cwd, containers=running_containers(), name=args.container
    )
    workdir = mount.translate(cwd)
    cmd = exec_argv(name=container.name, workdir=workdir, tty=tty, command=args.command)
    return cmd, f"{container.name}:{workdir}"


def main(argv: list[str] | None = None) -> None:
    """Parse arguments, then print (``--dry-run``) or exec the engine command.

    Args:
        argv: Command-line arguments; ``sys.argv[1:]`` when None.
    """
    parser = build_parser()
    args = parser.parse_args(argv)
    # argparse leaves the separator in a REMAINDER list
    if args.command[:1] == ["--"]:
        args.command = args.command[1:]
    args.running = args.running or args.container is not None
    problems = usage_errors(args)
    if problems:
        parser.error("; ".join(problems))

    cwd = Path.cwd().resolve()
    tty = sys.stdin.isatty()
    try:
        if args.running:
            cmd, banner = exec_running(args, cwd=cwd, tty=tty)
        else:
            cmd, banner = new_container(args, cwd=cwd, tty=tty)
    except Error as e:
        sys.exit(f"{parser.prog}: error: {e}")
    if args.dry_run:
        print(shlex.join(cmd))
        return
    print(f"▶ {banner}", file=sys.stderr)
    os.execvp(cmd[0], cmd)


if __name__ == "__main__":
    main()
