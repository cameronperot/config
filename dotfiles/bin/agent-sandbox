    "/usr",
    "/bin",
    "/sbin",
    "/lib",
    "/lib64",
    "/etc",
    "/opt",
    "/var",
    "/boot",
    "/root",
    "/srv",
    "/tmp",
    "/run",
    "/proc",
    "/sys",
    "/dev",
)

