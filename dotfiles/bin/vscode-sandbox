        "wp_content_type_manager_v1",
        "wp_fractional_scale_manager_v1",
        "wp_tearing_control_manager_v1",
        "zxdg_exporter_v1",
        "zxdg_importer_v1",
        "zxdg_exporter_v2",
        "zxdg_importer_v2",
        "xdg_activation_v1",
