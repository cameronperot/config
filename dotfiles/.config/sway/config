bar {
    swaybar_command waybar
}

# --------------------
# Autostart Applications
# --------------------
# Display
exec_always "systemctl --user restart kanshi.service"

# Background
exec swaybg -i $HOME/Pictures/background.png -m fill

# Night light
exec gammastep-indicator

# Browsers
assign [app_id="^firefox-default$"] workspace number 1
exec flatpak run org.mozilla.firefox --no-remote --name firefox-default -p default

assign [app_id="^firefox-proton$"] workspace number 13
exec flatpak run org.mozilla.firefox --no-remote --name firefox-proton -p proton

assign [app_id="^chromium-browser$"] workspace number 0
exec chromium-browser --profile-directory="Profile 1"

# Password manager
for_window [app_id="^org\.keepassxc\.KeePassXC$"] move scratchpad
exec $HOME/bin/kee

# Network Manager
exec nm-applet --indicator

# Bluetooth
exec blueman-applet

# Screen locking and power management
exec swayidle -w \
    timeout 900 'swaylock -f' \
    timeout 915 'swaymsg "output * power off"' \
        resume 'swaymsg "output * power on"' \
    timeout 930 'if grep -q "Discharging" /sys/class/power_supply/*/status 2>/dev/null; then systemctl suspend; fi' \
    timeout 3600 'if ! grep -q "Discharging" /sys/class/power_supply/*/status 2>/dev/null; then systemctl suspend; fi' \
    before-sleep 'swaylock -f' \
    lock 'swaylock -f'

# Power button
exec systemd-inhibit --what=handle-power-key sleep infinity
bindsym XF86PowerOff exec 'swaylock -f; systemctl suspend'

# --------------------
# Include system config
# --------------------
include '$(\
    /usr/libexec/sway/layered-include \
    $(ls /usr/share/sway/config.d/*.conf 2>/dev/null | grep -Ev "bar|bindings|swayidle") \
    "/etc/sway/config.d/*.conf" \
    "${XDG_CONFIG_HOME:-$HOME/.config}/sway/config.d/"*.conf \
)'
